# ==============================================================
# Copy this to .env and fill in your real values
# ==============================================================

# LiveKit Cloud — get from https://cloud.livekit.io → your project → Settings
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

# The single shared room name for your two-person portal
LIVEKIT_ROOM_NAME=walkie-talk-room

# User identities (must match what the apps send)
IOS_USER_ID=ios-user
ANDROID_USER_ID=android-user

# Firebase — download google-services.json from Firebase Console
# then point this at the file path
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Redis (optional for MVP — set USE_REDIS=false to use in-memory fallback)
USE_REDIS=false
REDIS_URL=redis://localhost:6379

# Backend URL (update when deployed)
BACKEND_URL=http://localhost:8000
