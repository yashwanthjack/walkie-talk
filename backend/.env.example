# ── Walkie-Talkie Backend — Environment Variables ──────────────────────────
# Copy this file to .env and fill in the values.

# Host/port (for reference — actual values passed via uvicorn CLI args)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — set to your frontend URL when deploying to production
# Leave as * for LAN/local development
ALLOWED_ORIGINS=*
